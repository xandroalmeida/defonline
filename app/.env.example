APP_NAME=DEFOnline
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8090
APP_VERSION=dev

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Logging
LOG_CHANNEL=stack
LOG_STACK=stdout,daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=90

# Database
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=defonline
DB_USERNAME=defonline_app
DB_PASSWORD=defonline_app_secret_local
DB_SUPERUSER=postgres
DB_SUPERUSER_PASSWORD=postgres_secret_local

# Sessions / cache / queue — todos no Postgres (ADR-001 + ADR-002)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Mail — em local vai para Mailpit (ADR-002)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="hello@defonline.local"
MAIL_FROM_NAME="${APP_NAME}"

# Telegram (canal `log` em local, sem internet)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Resend — provedor de email transacional em homol/prod (IDR-007).
# Local usa MAIL_MAILER=smtp + Mailpit (não precisa de chave). A variável
# precisa estar declarada porque config('services.resend.key') lê dela.
RESEND_API_KEY=

# RFB — Consulta de CNPJ (STORY-015 + IDR-004/005/006)
# `mock` é o default e cobre desenvolvimento/testes. STORY-018 ativa cnpja/receitaws.
RFB_PROVIDER=mock
RFB_TIMEOUT=5
RFB_CACHE_TTL=300
RFB_CNPJA_BASE_URL=https://open.cnpja.com
RFB_CNPJA_API_KEY=
RFB_CNPJA_RATE_LIMIT_PER_MINUTE=3
RFB_RECEITAWS_BASE_URL=https://receitaws.com.br/v1
RFB_RECEITAWS_API_KEY=
RFB_RECEITAWS_RATE_LIMIT_PER_MINUTE=3

VITE_APP_NAME="${APP_NAME}"

# STORY-065 / PDR-011 — e-mails da equipe com acesso ao backoffice (/backoffice/*),
# separados por vírgula. Vazio bloqueia todo mundo.
BACKOFFICE_EMAILS=

# Fuso de EXIBIÇÃO (IDR-025). Armazenamento e cálculo ficam em UTC.
APP_DISPLAY_TIMEZONE=America/Sao_Paulo

# Cobrança e pagamentos (EPIC-005, ADR-010). A cobrança nasce DESLIGADA (interruptor em /backoffice/planos).
# Provedor: `fake` (padrão fora de produção; sem rede) ou `asaas`. Em produção, vazio ou `fake` = sem provedor:
# o beta roda normalmente, os agendadores saem sem agir, o webhook responde 401 e o interruptor recusa ligar.
# Para ligar a cobrança, em produção: PAYMENTS_PROVIDER=asaas, ASAAS_BASE_URL=https://api.asaas.com/v3,
# ASAAS_API_KEY (prefixo $aact_prod_) e ASAAS_WEBHOOK_TOKEN (aleatório, 32 a 255 caracteres, diferente da chave).
# Sandbox: ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3 e a chave em ASAAS_SANDBOX_API_KEY (prefixo $aact_hmlg_).
# A chave tem que bater com o host, senão o adaptador recusa subir. Sem padrão de produção.
# O webhook se cadastra no painel do Asaas (ver README, "Cobrança: variáveis e webhook").
PAYMENTS_PROVIDER=fake
ASAAS_BASE_URL=
ASAAS_API_KEY=
ASAAS_SANDBOX_API_KEY=
ASAAS_WEBHOOK_TOKEN=
# Só se a URL cadastrada no provedor não for APP_URL/webhooks/pagamentos.
PAYMENTS_WEBHOOK_URL=
ASAAS_TIMEOUT=30
# Só do provedor fake (local/testes): segredo do cabeçalho do webhook simulado.
PAYMENTS_WEBHOOK_TOKEN=
# Validade do QR Code do Pix e do link de checkout com cartão, em minutos (cartão: o provedor aceita 10 a 1440).
PIX_EXPIRACAO_MINUTOS=30
CARTAO_EXPIRACAO_MINUTOS=60
# Menor cobrança que o provedor aceita (R$ 5,00). Abaixo disso a contratação é ativada sem cobrança.
PAGAMENTO_VALOR_MINIMO_CENTAVOS=500
# A partir de quantos dias do vencimento o lote de créditos ganha o alerta de "perto de vencer".
LOTE_PERTO_DE_VENCER_DIAS=30
