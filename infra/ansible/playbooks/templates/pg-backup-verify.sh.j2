#!/usr/bin/env bash
# Verificação diária do backup — roda depois da janela do pg-backup.sh.
# Renderizado pelo Ansible a partir de templates/pg-backup-verify.sh.j2.
#
# Existe porque um script não consegue alertar sobre a própria ausência: se o
# cron for removido, o `docker compose` morrer antes da primeira linha ou a VPS
# for reprovisionada sem o backup.yml, o pg-backup.sh simplesmente não roda — e
# silêncio, no desenho anterior, era indistinguível de sucesso.
#
# Responde três perguntas, todas contra a R2 (fonte de verdade, não o disco local):
#   1. Existe um dump em daily/ com menos de N horas?
#   2. Ele tem tamanho plausível?
#   3. Ele ainda é DECIFRÁVEL e LEGÍVEL pelo pg_restore?
#
# (3) é um mini-restore drill todo dia. Barato: a R2 não cobra egress, e o dump
# é da ordem de dezenas de KB. É o que separa "o arquivo chegou" de "o arquivo
# serve" — passphrase GPG trocada por engano, ou objeto truncado no upload,
# só aparecem aqui. Não substitui o drill trimestral do restore.yml, que exercita
# o caminho completo até o banco de pé.

set -euo pipefail
umask 077

DEPLOY_DIR="{{ deploy_dir }}"
BUCKET="{{ r2_bucket }}"
ENV_NAME="{{ env_name }}"
MAX_IDADE_H="{{ backup_max_idade_horas }}"
GPG_PASS_FILE="$HOME/.backup-gpg-pass"
TELEGRAM_FILE="$HOME/.backup-telegram"

BASE="r2:${BUCKET}/postgres/${ENV_NAME}"
TMPDIR_V=$(mktemp -d /tmp/pg-verify.XXXXXX)
trap 'rm -rf "$TMPDIR_V"' EXIT

alertar() {
    local titulo="$1" corpo="$2" msg
    msg=$(printf '%s\nAmbiente: %s\nHost: %s\nQuando: %s\n\n%s' \
        "$titulo" "$ENV_NAME" "$(hostname)" "$(date -Iseconds)" "$corpo")

    if [ ! -r "$TELEGRAM_FILE" ]; then
        echo "✖ $TELEGRAM_FILE ausente — alerta NÃO enviado: ${titulo}" >&2
        return 0
    fi
    # shellcheck disable=SC1090
    . "$TELEGRAM_FILE"
    if [ -z "${TELEGRAM_BOT_TOKEN:-}" ] || [ -z "${TELEGRAM_CHAT_ID:-}" ]; then
        echo "✖ Credencial do Telegram vazia — alerta NÃO enviado: ${titulo}" >&2
        return 0
    fi
    curl -sS --max-time 15 --retry 2 -o /dev/null \
        --data-urlencode "chat_id=${TELEGRAM_CHAT_ID}" \
        --data-urlencode "text=${msg}" \
        "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage" \
        || echo "✖ Telegram recusou o alerta: ${titulo}" >&2
}

falhar() {
    echo "✖ $1"
    alertar "🚨 [P1] DEFOnline — verificação de backup FALHOU" "$1"
    exit 1
}

cd "$DEPLOY_DIR"
echo "==> $(date -Iseconds) verificando backups em ${BASE}/daily/"

# 1 — existe dump recente?
ULTIMO=$(rclone lsf "${BASE}/daily/" -R --files-only --format "tp" --separator "|" 2>/dev/null \
         | sort -r | head -1) || true

[ -n "$ULTIMO" ] || falhar "Nenhum dump encontrado em ${BASE}/daily/. O backup não está rodando."

TS="${ULTIMO%%|*}"
CAMINHO="${ULTIMO#*|}"
IDADE_H=$(( ( $(date +%s) - $(date -d "$TS" +%s) ) / 3600 ))
echo "==> Mais recente: ${CAMINHO} (${TS}, ${IDADE_H}h atrás)"

if [ "$IDADE_H" -gt "$MAX_IDADE_H" ]; then
    falhar "$(printf 'Backup mais recente tem %sh (limite: %sh).\nArquivo: %s\nO cron das 03:00 não rodou ou falhou antes do upload.' \
        "$IDADE_H" "$MAX_IDADE_H" "$CAMINHO")"
fi

# 2 — tamanho plausível + 3 — decifra e o pg_restore lê o índice?
rclone copyto "${BASE}/daily/${CAMINHO}" "${TMPDIR_V}/ultimo.gpg" \
    || falhar "Não consegui baixar ${CAMINHO} da R2."

SIZE=$(stat -c%s "${TMPDIR_V}/ultimo.gpg")
[ "$SIZE" -ge 1000 ] || falhar "Dump ${CAMINHO} tem apenas ${SIZE} bytes na R2."

gpg --batch --yes --decrypt --passphrase-file "$GPG_PASS_FILE" \
    "${TMPDIR_V}/ultimo.gpg" 2>/dev/null | gunzip > "${TMPDIR_V}/ultimo.dump" \
    || falhar "$(printf 'Não consegui decifrar/descomprimir %s.\nPassphrase GPG divergente ou objeto corrompido.' "$CAMINHO")"

TOC=$(docker compose exec -T db pg_restore --list < "${TMPDIR_V}/ultimo.dump" 2>/dev/null | grep -c ';' ) || true
echo "==> pg_restore leu ${TOC} entradas de TOC"

[ "${TOC:-0}" -ge 10 ] \
    || falhar "$(printf 'pg_restore não conseguiu ler %s (apenas %s entradas de TOC).\nO arquivo chegou na R2 mas não serve para restore.' "$CAMINHO" "${TOC:-0}")"

echo "==> $(date -Iseconds) Verificação ok."

{% if backup_verify_resumo_semanal %}
# Resumo semanal: silêncio absoluto é indistinguível de canal quebrado. Uma
# mensagem por semana prova que o caminho de alerta ainda funciona. Desligue em
# group_vars com `backup_verify_resumo_semanal: false` se virar ruído.
if [ "$(date +%u)" = "{{ backup_verify_resumo_dia_semana }}" ]; then
    N_DAILY=$(rclone lsf "${BASE}/daily/" -R --files-only 2>/dev/null | wc -l)
    N_MONTHLY=$(rclone lsf "${BASE}/monthly/" -R --files-only 2>/dev/null | wc -l)
    TOTAL=$(rclone size "${BASE}/" --json 2>/dev/null | tr -d '{}"' | tr ',' '\n' | grep bytes | cut -d: -f2)
    alertar "✅ DEFOnline — resumo semanal de backup" \
        "$(printf 'Último dump: %s (%sh atrás)\nTamanho: %s bytes | TOC: %s entradas\nCópias diárias: %s | mensais: %s\nTotal no bucket: %s bytes\nBucket: %s' \
            "$CAMINHO" "$IDADE_H" "$SIZE" "$TOC" "$N_DAILY" "$N_MONTHLY" "${TOTAL:-?}" "$BUCKET")"
fi
{% endif %}
