#!/usr/bin/env bash
# Backup diário Postgres → gzip → GPG (AES256) → Cloudflare R2 (ADR-005 §4.2).
# Renderizado pelo Ansible a partir de templates/pg-backup.sh.j2 — NÃO editar na
# VPS: rode `ansible-playbook playbooks/backup.yml` para atualizar. (Sem carimbo
# de data aqui de propósito: faria a task reportar `changed` em toda execução.)
#
# Layout no bucket (dois prefixos com retenções independentes — ADR-005 §4.2
# pede "30 dias rolantes + 12 cópias mensais", o que é impossível num prefixo
# único: qualquer limpeza por idade apagaria as mensais junto):
#
#   postgres/<ambiente>/daily/YYYY/MM/dump-YYYYMMDD-HHMM.sql.gz.gpg
#   postgres/<ambiente>/monthly/YYYY/dump-YYYYMM.sql.gz.gpg   (só no dia 01)
#
# Qualquer falha vira alerta no Telegram (ADR-004 §1). O que este script NÃO
# consegue detectar sobre si mesmo — não ter rodado — é coberto pelo
# pg-backup-verify.sh, que roda depois e cobra a existência de um dump recente.

set -euo pipefail
umask 077

DEPLOY_DIR="{{ deploy_dir }}"
DB_NAME="{{ postgres_db }}"
BACKUP_DB_USER="{{ postgres_backup_user }}"
BUCKET="{{ r2_bucket }}"
ENV_NAME="{{ env_name }}"
RETENTION_DAILY="{{ backup_retention_daily }}"
RETENTION_MONTHLY_DAYS=$(( {{ backup_retention_monthly }} * 31 ))
GPG_PASS_FILE="$HOME/.backup-gpg-pass"
TELEGRAM_FILE="$HOME/.backup-telegram"

BASE="r2:${BUCKET}/postgres/${ENV_NAME}"

ETAPA="inicialização"
AVISOS=""

# Fala HTTP direto com a Bot API em vez de passar pelo Laravel de propósito:
# quando o backup falha, é bem possível que o container `web` também esteja
# quebrado — o canal de alerta não pode depender do que ele monitora.
alertar() {
    local titulo="$1" corpo="$2" msg
    msg=$(printf '%s\nAmbiente: %s\nHost: %s\nQuando: %s\n\n%s' \
        "$titulo" "$ENV_NAME" "$(hostname)" "$(date -Iseconds)" "$corpo")

    if [ ! -r "$TELEGRAM_FILE" ]; then
        echo "✖ $TELEGRAM_FILE ausente — alerta NÃO enviado: ${titulo}" >&2
        return 0
    fi
    # shellcheck disable=SC1090
    . "$TELEGRAM_FILE"
    if [ -z "${TELEGRAM_BOT_TOKEN:-}" ] || [ -z "${TELEGRAM_CHAT_ID:-}" ]; then
        echo "✖ Credencial do Telegram vazia — alerta NÃO enviado: ${titulo}" >&2
        return 0
    fi
    if ! curl -sS --max-time 15 --retry 2 -o /dev/null \
            --data-urlencode "chat_id=${TELEGRAM_CHAT_ID}" \
            --data-urlencode "text=${msg}" \
            "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage"; then
        echo "✖ Telegram recusou o alerta: ${titulo}" >&2
    fi
}

# Todo o corpo escreve no RUNLOG e o trap despeja tudo no stdout no final (que o
# cron acumula em backups/backup.log). Redirecionar em vez de `tee` é escolha
# deliberada: com process substitution não há garantia de que o tee tenha dado
# flush quando o trap lê o arquivo para montar o alerta.
RUNLOG=$(mktemp /tmp/pg-backup.XXXXXX)
exec 3>&1 4>&2
exec >"$RUNLOG" 2>&1

finalizar() {
    local rc=$1
    exec 1>&3 2>&4
    cat "$RUNLOG"

    if [ "$rc" -ne 0 ]; then
        alertar "🚨 [P1] DEFOnline — backup do banco FALHOU" \
            "$(printf 'Etapa: %s\nCódigo de saída: %s\n\nÚltimas linhas:\n%s' \
                "$ETAPA" "$rc" "$(tail -n 12 "$RUNLOG")")"
    elif [ -n "$AVISOS" ]; then
        alertar "⚠️ [P2] DEFOnline — backup concluiu com avisos" "$AVISOS"
    fi
    rm -f "$RUNLOG"
}
trap 'finalizar $?' EXIT

# Trava: se o backup anterior ainda estiver rodando, a segunda execução não
# disputa CPU/disco com a primeira. Vale um aviso — um backup que atravessa a
# janela de 24h é sinal de que o banco cresceu além do desenho.
exec 9>"${DEPLOY_DIR}/backups/.pg-backup.lock"
if ! flock -n 9; then
    echo "==> $(date -Iseconds) execução anterior ainda em andamento; abortando esta."
    AVISOS="- Execução anterior ainda rodando na hora do cron (backup ignorado)."$'\n'
    exit 0
fi

cd "$DEPLOY_DIR"

DATE=$(date +%Y%m%d-%H%M)
YEAR=$(date +%Y)
MONTH=$(date +%m)
DAY=$(date +%d)
LOCAL_FILE="backups/dump-${DATE}.sql.gz.gpg"
DAILY_REMOTE="${BASE}/daily/${YEAR}/${MONTH}/dump-${DATE}.sql.gz.gpg"
MONTHLY_REMOTE="${BASE}/monthly/${YEAR}/dump-${YEAR}${MONTH}.sql.gz.gpg"

ETAPA="pg_dump + gzip + GPG"
echo "==> $(date -Iseconds) pg_dump → gzip → GPG → ${LOCAL_FILE}"

# pg_dump em formato custom (permite restore parcial/seletivo), comprimido e
# cifrado. Roda pelo role defonline_backup (read-only, sem DROP) — ADR-005 §7.4.
docker compose exec -T db \
    pg_dump \
        --username="$BACKUP_DB_USER" \
        --format=custom \
        --no-owner \
        --no-acl \
        "$DB_NAME" \
    | gzip \
    | gpg --batch --yes --symmetric \
          --cipher-algo AES256 \
          --passphrase-file "$GPG_PASS_FILE" \
          --output "$LOCAL_FILE"

SIZE=$(stat -c%s "$LOCAL_FILE" 2>/dev/null || stat -f%z "$LOCAL_FILE")
echo "==> Tamanho do dump: ${SIZE} bytes"

# Guarda-corpo contra "backup verde com arquivo vazio": um dump do DEFOnline
# cifrado nunca fica abaixo de 1 KB, nem com o banco recém-migrado e sem dados.
ETAPA="validação de tamanho"
if [ "$SIZE" -lt 1000 ]; then
    echo "✖ Dump muito pequeno (${SIZE} bytes < 1KB). Abortando upload."
    exit 1
fi

ETAPA="upload para a R2"
echo "==> Upload → ${DAILY_REMOTE}"
rclone copyto "$LOCAL_FILE" "$DAILY_REMOTE"

# Cópia mensal: server-side copy dentro da própria R2 (não re-envia bytes da
# VPS, e não conta egress). Roda no dia 01 — o dump de 03:00 do dia 01 vira a
# fotografia do mês anterior fechado.
if [ "$DAY" = "01" ]; then
    ETAPA="cópia mensal"
    echo "==> Cópia mensal → ${MONTHLY_REMOTE}"
    rclone copyto "$DAILY_REMOTE" "$MONTHLY_REMOTE"
fi

# Limpeza local: a VPS guarda só a janela curta; a retenção real é a da R2.
ETAPA="limpeza local"
find "${DEPLOY_DIR}/backups" -name 'dump-*.sql.gz.gpg' -mtime +7 -delete

# Retenção na R2 — cada prefixo com sua idade máxima. Escopado em `daily/` e
# `monthly/` separadamente: apontar para a raiz apagaria as mensais junto.
# Falha aqui não invalida o backup recém-enviado (por isso não aborta), mas vira
# aviso: retenção que para de rodar em silêncio vira conta no fim do mês.
ETAPA="retenção na R2"
echo "==> Retenção: daily > ${RETENTION_DAILY}d, monthly > ${RETENTION_MONTHLY_DAYS}d"
if ! rclone delete "${BASE}/daily/" --min-age "${RETENTION_DAILY}d" --include 'dump-*.sql.gz.gpg'; then
    AVISOS+="- Limpeza do prefixo daily/ falhou."$'\n'
fi
if ! rclone delete "${BASE}/monthly/" --min-age "${RETENTION_MONTHLY_DAYS}d" --include 'dump-*.sql.gz.gpg'; then
    AVISOS+="- Limpeza do prefixo monthly/ falhou."$'\n'
fi

ETAPA="conclusão"
echo "==> $(date -Iseconds) Backup ok."
