# Cloudflare R2 via API S3-compatível (ADR-005 §4.2, revisado em 2026-08-04).
# Renderizado pelo Ansible — NÃO editar na VPS (é sobrescrito a cada backup.yml).
#
# `provider = Cloudflare` faz o rclone desligar as chamadas S3 que a R2 não
# implementa (ex.: GetBucketLocation). `no_check_bucket = true` é obrigatório
# aqui: sem ele o rclone tenta um HeadBucket/CreateBucket antes do primeiro
# upload, e o token escopado em "Object Read & Write" não tem permissão de
# bucket — o backup falharia mesmo com o bucket já existindo.
[r2]
type = s3
provider = Cloudflare
access_key_id = {{ r2_access_key_id }}
secret_access_key = {{ r2_secret_access_key }}
endpoint = https://{{ r2_account_id }}.r2.cloudflarestorage.com
region = auto
acl = private
no_check_bucket = true
