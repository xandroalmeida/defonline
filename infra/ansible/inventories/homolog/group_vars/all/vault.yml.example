---
# Template do Ansible Vault — copie para `vault.yml` e cifre com:
#   cd infra/ansible
#   cp inventories/homolog/group_vars/vault.yml.example inventories/homolog/group_vars/vault.yml
#   # preencha os valores reais
#   ansible-vault encrypt inventories/homolog/group_vars/vault.yml
#
# Senha do vault: grave em ~/.ansible-vault-pass-homolog (chmod 600), ou use --ask-vault-pass.
# NÃO comitar `vault.yml` em texto claro — apenas a versão cifrada.

# PostgreSQL (gere com `openssl rand -base64 32`)
vault_db_app_password: "REPLACE_ME"
vault_db_backup_password: "REPLACE_ME"
vault_db_superuser_password: "REPLACE_ME"

# Cloudflare R2 — token S3 escopado no bucket do ambiente.
# Passo a passo: defonline-docs/project-state/runbooks/runbook-backup-r2.md
#   Dash Cloudflare → R2 → API → Manage API tokens → Create Account API token
#   Permissão: "Object Read & Write", aplicada APENAS a `defonline-backup-homolog`.
# O Account ID aparece na home da R2 e compõe o endpoint S3.
vault_r2_account_id: "REPLACE_ME"
vault_r2_access_key_id: "REPLACE_ME"
vault_r2_secret_access_key: "REPLACE_ME"

# GPG passphrase usado para cifrar pg_dump (gere com `openssl rand -base64 32`).
# A chave GPG própria é gerada por scripts/gen-backup-gpg-key.sh e instalada na VPS.
vault_backup_gpg_passphrase: "REPLACE_ME"

# Telegram bot (criado via @BotFather; ADR-004 §1.5)
vault_telegram_bot_token: "0000000000:REPLACE_ME"
vault_telegram_chat_id_homolog: "-1000000000000"

# GHCR pull token — Personal Access Token com escopo read:packages.
# Se o repo for público, pode ser vazio.
vault_ghcr_pull_token: ""

# RFB — API keys dos provedores reais (STORY-018 / IDR-004 / IDR-006).
# Plano gratuito de cada provedor dispensa token; preencher só se contratar plano pago.
# Em homologação, o default operacional é `cnpja` no plano pago (api.cnpja.com).
# Após contratar: gerar a chave no painel do provedor, gravar aqui via
#   ansible-vault edit inventories/homolog/group_vars/all/vault.yml
vault_rfb_cnpja_api_key: ""
vault_rfb_receitaws_api_key: ""

# Resend — API key do provedor de email transacional (IDR-007).
# Gerar em https://resend.com/api-keys após verificar o domínio defonline.xandrix.com.br
# (SPF/DKIM/DMARC publicados conforme painel Resend). Formato: `re_<32_chars>`.
# Sem essa chave + mail_mailer=resend, o Laravel rejeita o envio em runtime.
vault_resend_api_key: ""
